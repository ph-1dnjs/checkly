{
  "name": "checkly",
  "version": "0.1.10",
  "private": true,
  "description": "Checkly desktop browser QA application built with Electron, React, Playwright, and FSD.",
  "main": "dist-electron/main.js",
  "author": "ph-1dnjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ph-1dnjs/checkly"
  },
  "scripts": {
    "dev:api:web": "vite --mode api-web",
    "dev": "tsc -p tsconfig.electron.json && concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on --timeout 30000 http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:api": "tsx --test tests/api-testing/*.test.ts",
    "test:api:desktop": "npm run build && tsx tests/api-testing/desktop.e2e.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck:api": "tsc --noEmit --strict --skipLibCheck --esModuleInterop --target ES2022 --module commonjs --moduleResolution node src/app/api-testing/main/execution.ts",
    "package": "npm run build && dotenv -e .env -- electron-builder",
    "package:dir": "npm run build && dotenv -e .env -- electron-builder --dir",
    "postinstall": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium"
  },
  "build": {
    "appId": "dev.ph1dnjs.checkly",
    "productName": "Checkly",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/playwright-core/.local-browsers/**"
    ],
    "mac": {
      "icon": "build/icons/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ph-1dnjs",
        "repo": "checkly",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.55.0",
    "dompurify": "^3.4.15",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "mermaid": "^11.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "swagger-ui-react": "^5.32.15",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "storybook": "^10.6.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
