  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "src/app",
    "types": ["node"]
  },
  "include": ["src/app/main.ts", "src/app/preload.ts"]
}
